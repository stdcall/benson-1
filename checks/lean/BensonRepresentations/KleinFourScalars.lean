import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic.LinearCombination

/-!
# The scalars in the relations of `kA₄`: proof of Theorem 6.6.2

Book: D. J. Benson, *Representations and Cohomology I*, second edition
(1998), printed p. 220, proof of Theorem 6.6.2: in the basic algebra given
by the Ext-quiver with arrows `α, β, γ, δ, ε, ζ` there are non-zero
constants `μ₁, μ₂, μ₃` with `βα = μ₁ ζε`, `εζ = μ₂ δγ` and `γδ = μ₃ αβ`.
"By replacing (say) `ζ` and `δ` by non-zero multiples, we may assume that
`μ₁ = μ₂ = 1`.  Now `B` is a symmetric algebra … if `λ` is a linear map as
in the definition of symmetric algebra then `0 ≠ λ(αβ) = λ(βα) = λ(ζε) =
λ(εζ) = λ(δγ) = λ(γδ) = μ₃ λ(αβ)` and so `μ₃ = 1`."

Notation.  `A` is an algebra over a field `k` (the basic algebra), the six
arrows are elements of `A`, and `λ : A →ₗ[k] k` satisfies `λ(xy) = λ(yx)`.

* `rescale`: with `ζ' = μ₁ ζ` and `δ' = μ₁ μ₂ δ` the relations hold with
  `μ₁ = μ₂ = 1` and `μ₃` replaced by `μ₁ μ₂ μ₃`; the six zero relations
  `δα = βγ = αζ = εβ = ζδ = γε = 0` are preserved.
* `scalar_product_eq_one`: if `λ(αβ) ≠ 0` then `μ₁ μ₂ μ₃ = 1`; so after
  the rescaling `μ₃ = 1`.
* `trace_ne_zero`: `λ(αβ) ≠ 0` follows from `αβ ≠ 0`, the non-degeneracy of
  `λ` (`λ(A x) = 0` implies `x = 0`, "λ cannot vanish on the left ideal
  generated by `αβ`") and `A αβ ⊆ k αβ` (`αβ` spans the socle at its
  vertex, a property of the basic algebra assumed here).

Not covered: the structure of the projective modules and the Ext-quiver
(checked for `kA₄`, `kA₄ × C₃`, `kA₄ × S₃` and the explicit isomorphism with
`kA₄` in `checks/sage/chapter-6.py`), and that the relations listed are all
relations.
-/

namespace BensonRepresentations.KleinFourScalars

variable {k A : Type*} [Field k] [Ring A] [Algebra k A]

/-- Rescaling `ζ` and `δ` normalises `μ₁` and `μ₂`; `μ₃` becomes
`μ₁ μ₂ μ₃`; the zero relations are preserved. -/
theorem rescale (α β γ δ ε ζ : A) (μ₁ μ₂ μ₃ : k)
    (h₁ : β * α = μ₁ • (ζ * ε)) (h₂ : ε * ζ = μ₂ • (δ * γ))
    (h₃ : γ * δ = μ₃ • (α * β))
    (z : δ * α = 0 ∧ β * γ = 0 ∧ α * ζ = 0 ∧ ε * β = 0 ∧ ζ * δ = 0 ∧ γ * ε = 0) :
    let ζ' := μ₁ • ζ
    let δ' := (μ₁ * μ₂) • δ
    β * α = ζ' * ε ∧ ε * ζ' = δ' * γ ∧ γ * δ' = (μ₁ * μ₂ * μ₃) • (α * β) ∧
      (δ' * α = 0 ∧ β * γ = 0 ∧ α * ζ' = 0 ∧ ε * β = 0 ∧ ζ' * δ' = 0 ∧
        γ * ε = 0) := by
  obtain ⟨z₁, z₂, z₃, z₄, z₅, z₆⟩ := z
  refine ⟨?_, ?_, ?_, ?_, z₂, ?_, z₄, ?_, z₆⟩
  · rw [h₁, smul_mul_assoc]
  · rw [mul_smul_comm, h₂, smul_mul_assoc, smul_smul]
  · rw [mul_smul_comm, h₃, smul_smul]
  · rw [smul_mul_assoc, z₁, smul_zero]
  · rw [mul_smul_comm, z₃, smul_zero]
  · rw [smul_mul_assoc, mul_smul_comm, z₅, smul_zero, smul_zero]

/-- The symmetrising form forces `μ₁ μ₂ μ₃ = 1`. -/
theorem scalar_product_eq_one (α β γ δ ε ζ : A) (μ₁ μ₂ μ₃ : k)
    (h₁ : β * α = μ₁ • (ζ * ε)) (h₂ : ε * ζ = μ₂ • (δ * γ))
    (h₃ : γ * δ = μ₃ • (α * β)) (lam : A →ₗ[k] k)
    (hsym : ∀ x y, lam (x * y) = lam (y * x)) (hne : lam (α * β) ≠ 0) :
    μ₁ * μ₂ * μ₃ = 1 := by
  have e1 : lam (α * β) = μ₁ * lam (ζ * ε) := by
    rw [hsym, h₁, map_smul, smul_eq_mul]
  have e2 : lam (ζ * ε) = μ₂ * lam (δ * γ) := by
    rw [hsym, h₂, map_smul, smul_eq_mul]
  have e3 : lam (δ * γ) = μ₃ * lam (α * β) := by
    rw [hsym, h₃, map_smul, smul_eq_mul]
  have key : (μ₁ * μ₂ * μ₃ - 1) * lam (α * β) = 0 := by
    linear_combination -e1 - μ₁ * e2 - μ₁ * μ₂ * e3
  have := mul_eq_zero.mp key
  rcases this with h | h
  · exact sub_eq_zero.mp h
  · exact absurd h hne

/-- `λ(αβ) ≠ 0` from the non-degeneracy of `λ`. -/
theorem trace_ne_zero (x : A) (lam : A →ₗ[k] k)
    (hnd : ∀ y : A, (∀ a : A, lam (a * y) = 0) → y = 0)
    (hsoc : ∀ a : A, ∃ c : k, a * x = c • x) (hx : x ≠ 0) : lam x ≠ 0 := by
  intro h0
  apply hx
  apply hnd
  intro a
  obtain ⟨c, hc⟩ := hsoc a
  rw [hc, map_smul, h0, smul_zero]

end BensonRepresentations.KleinFourScalars

#print axioms BensonRepresentations.KleinFourScalars.rescale
#print axioms BensonRepresentations.KleinFourScalars.scalar_product_eq_one
#print axioms BensonRepresentations.KleinFourScalars.trace_ne_zero
