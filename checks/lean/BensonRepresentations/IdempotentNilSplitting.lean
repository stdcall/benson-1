import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.RingTheory.Nilpotent.Defs
import Mathlib.Tactic.LinearCombination

/-!
# Idempotents modulo a nil ideal in characteristic `p`: Proposition 6.2.2

Book: D. J. Benson, *Representations and Cohomology I*, second edition
(1998), printed pp. 204–205, Proposition 6.2.2 and its proof: if `D` is a
normal `p`-subgroup of `G` then every idempotent of `Z(kG)` lies in
`kC_G(D)`.  The proof splits `(kG)^D = kC_G(D) ⊕ ∑_{D' < D} (kG)^D_{D'}` with
the second summand inside `J(kG)` (Lemma 6.2.1).  The printed sentence
"every idempotent in `(kG)^D` lies in `kC_G(D)`" fails when `(kG)^D` is not
commutative (a counterexample for `S₃ × S₃`, `p = 3`, is in
`checks/sage/chapter-6.py`); for the idempotents of the commutative ring
`Z(kG) = (kG)^G = (kC_G(D))^G ⊕ ∑_{D ≰ Q} (kG)^G_Q` (Lemma 6.2.1 (ii) with
`N_G(D) = G`) the conclusion follows from the Frobenius map, as formalized
here.

Notation.  `R` is a commutative ring of prime characteristic `p` (the centre
`Z(kG)`), `S` a subring (`(kC_G(D))^G`), and the idempotent `e` is written
`e = s + i` with `s ∈ S` and `i` nilpotent (an element of the ideal
`∑ (kG)^G_Q ⊆ J(kG)`, which is nilpotent).  The direct sum decomposition
itself and the inclusion of the ideal in `J(kG)` (Lemma 6.2.1 and the first
part of the proof) are not formalized; they are checked in
`checks/sage/chapter-6.py` for the groups listed there.

* `idempotent_eq_pow`: `e = s ^ (p ^ n)` for some `n`.
* `idempotent_mem_subring`: hence `e ∈ S`.
* `idempotent_of_nilpotent`: an idempotent that is nilpotent is zero.
* `idempotent_eq_of_sub_nilpotent`, `map_injOn_idempotents`,
  `map_ne_zero_of_idempotent`: a homomorphism of commutative rings with
  nilpotent kernel is injective on idempotents and does not kill a non-zero
  idempotent.  This is the step "has as its kernel `J(kQ).C_G(Q)`, which is
  nilpotent" of the proof of Lemma 6.4.2 (p. 210), for
  `π : Z(kC_G(Q)) → Z(kC_G(Q)/Z(Q))`, and the step `π(Br_D(e)) ≠ 0` of the
  corrected proof (`π` on `kC_G(D)`, whose kernel is nilpotent; there `R` is
  replaced by the commutative subalgebra generated by `Br_D(e)`).  That the
  image of `π` contains every idempotent of `Z(kC_G(Q)/Z(Q))` (the printed
  proof claims that `π` is onto, which is false) is not formalized; it is
  checked in `checks/sage/chapter-6.py`.
-/

namespace BensonRepresentations.IdempotentNilSplitting

variable {R : Type*} [CommRing R]

/-- The Frobenius step: an idempotent `e = s + i` with `i` nilpotent equals
`s ^ (p ^ n)` for some `n`. -/
theorem idempotent_eq_pow (p : ℕ) [hp : Fact p.Prime] [CharP R p] {e s i : R}
    (he : IsIdempotentElem e) (hsi : e = s + i) (hi : IsNilpotent i) :
    ∃ n : ℕ, e = s ^ (p ^ n) := by
  obtain ⟨k, hk⟩ := hi
  refine ⟨k, ?_⟩
  have hk' : k ≤ p ^ k := (Nat.lt_pow_self hp.out.one_lt).le
  have hzero : i ^ (p ^ k) = 0 := pow_eq_zero_of_le hk' hk
  have hpos : p ^ k ≠ 0 := pow_ne_zero _ hp.out.ne_zero
  have hpow : e ^ (p ^ k) = e := by
    obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hpos
    rw [hm]
    exact he.pow_succ_eq m
  calc e = e ^ (p ^ k) := hpow.symm
    _ = (s + i) ^ (p ^ k) := by rw [hsi]
    _ = s ^ (p ^ k) + i ^ (p ^ k) := by rw [add_pow_char_pow]
    _ = s ^ (p ^ k) := by rw [hzero, add_zero]

/-- Proposition 6.2.2 (corrected step): the idempotent lies in the
subring. -/
theorem idempotent_mem_subring (p : ℕ) [Fact p.Prime] [CharP R p] (S : Subring R)
    {e s i : R} (he : IsIdempotentElem e) (hs : s ∈ S) (hsi : e = s + i)
    (hi : IsNilpotent i) : e ∈ S := by
  obtain ⟨n, hn⟩ := idempotent_eq_pow p he hsi hi
  rw [hn]
  exact S.pow_mem hs _

/-- A nilpotent idempotent is zero. -/
theorem idempotent_of_nilpotent {e : R} (he : IsIdempotentElem e)
    (hn : IsNilpotent e) : e = 0 := by
  obtain ⟨k, hk⟩ := hn
  rcases Nat.eq_zero_or_pos k with rfl | hpos
  · have h1 : (1 : R) = 0 := by simpa using hk
    calc e = e * 1 := (mul_one e).symm
      _ = 0 := by rw [h1, mul_zero]
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hpos.ne'
    rw [he.pow_succ_eq m] at hk
    exact hk

/-- Two idempotents of a commutative ring whose difference is nilpotent are
equal: `x = e - f` satisfies `x ^ 3 = x`. -/
theorem idempotent_eq_of_sub_nilpotent {e f : R} (he : IsIdempotentElem e)
    (hf : IsIdempotentElem f) (hn : IsNilpotent (e - f)) : e = f := by
  have h3 : (e - f) ^ 3 = e - f := by
    have h1 : e * e = e := he.eq
    have h2 : f * f = f := hf.eq
    linear_combination (e + 1 - 3 * f) * h1 - (f + 1 - 3 * e) * h2
  have hodd : ∀ k : ℕ, (e - f) ^ (2 * k + 1) = e - f := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc (e - f) ^ (2 * (k + 1) + 1) = (e - f) ^ (2 * k + 1) * (e - f) ^ 2 := by
            rw [← pow_add]; ring_nf
        _ = (e - f) ^ 3 := by rw [ih]; ring
        _ = e - f := h3
  obtain ⟨k, hk⟩ := hn
  have : (e - f) ^ (2 * k + 1) = 0 := pow_eq_zero_of_le (by omega) hk
  rw [hodd k] at this
  exact sub_eq_zero.mp this

/-- Lemma 6.4.2 and Proposition 6.2.2: a ring homomorphism of commutative
rings with nilpotent kernel is injective on idempotents and sends non-zero
idempotents to non-zero idempotents. -/
theorem map_injOn_idempotents {S : Type*} [CommRing S] (φ : R →+* S)
    (hker : ∀ x, φ x = 0 → IsNilpotent x) {e f : R} (he : IsIdempotentElem e)
    (hf : IsIdempotentElem f) (h : φ e = φ f) : e = f :=
  idempotent_eq_of_sub_nilpotent he hf (hker _ (by rw [map_sub, h, sub_self]))

theorem map_ne_zero_of_idempotent {S : Type*} [CommRing S] (φ : R →+* S)
    (hker : ∀ x, φ x = 0 → IsNilpotent x) {e : R} (he : IsIdempotentElem e)
    (hne : e ≠ 0) : φ e ≠ 0 := fun h0 => hne (idempotent_of_nilpotent he (hker e h0))

end BensonRepresentations.IdempotentNilSplitting

#print axioms BensonRepresentations.IdempotentNilSplitting.idempotent_eq_pow
#print axioms BensonRepresentations.IdempotentNilSplitting.idempotent_mem_subring
#print axioms BensonRepresentations.IdempotentNilSplitting.idempotent_of_nilpotent
#print axioms BensonRepresentations.IdempotentNilSplitting.idempotent_eq_of_sub_nilpotent
#print axioms BensonRepresentations.IdempotentNilSplitting.map_injOn_idempotents
#print axioms BensonRepresentations.IdempotentNilSplitting.map_ne_zero_of_idempotent
